# Copy to .env.local (never commit real values).

# Shown on the landing page and the browser tab.
NEXT_PUBLIC_APP_NAME=Document Search

# --- Public app URL (used in invitation e-mails; falls back to the request host)
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# --- Supabase: auth, data, chat history and document storage
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required: storage, invitations, feedback aggregates, vector-store sync status.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for the original documents (created by the migrations).
SUPABASE_STORAGE_BUCKET=knowledge
# Max upload size in MB. Files go straight from the browser to Supabase Storage,
# so Vercel's ~4.5 MB request-body limit does not apply. Also check the bucket's
# file size limit in Supabase (Storage settings; 50 MB on the free plan).
MAX_UPLOAD_MB=25

# --- OpenAI (Responses API + file_search + vector stores)
OPENAI_API_KEY=
# The model ids must be enabled for this key.
OPENAI_MODEL_ANSWER=gpt-6-luna
# low | medium | high | max
OPENAI_REASONING_EFFORT=low
# low | medium | high
OPENAI_TEXT_VERBOSITY=medium
OPENAI_MAX_OUTPUT_TOKENS=8000
# 20–50. The app does not go below 20: fewer chunks missed the cited passage.
OPENAI_FILE_SEARCH_MAX_RESULTS=20
# Small side tasks (follow-up suggestions, document classification). Defaults to
# OPENAI_MODEL_ANSWER with no reasoning.
# OPENAI_MODEL_UTILITY=
# OPENAI_UTILITY_EFFORT=none
# Reads a document and proposes name, type, audience, source and context.
# OPENAI_MODEL_METADATA=gpt-6-astra
# OPENAI_METADATA_EFFORT=low
# Realtime voice calls (POST /api/voice/session). Marin speaks the Spanish
# instructions; transcription language is es. Optional overrides:
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin

# --- Resend (team invitations and library alerts)
RESEND_API_KEY=
# Address on a domain you verified in Resend. Example: Document Search <notifications@example.com>
EMAIL_FROM=

# --- Computer use (local harness only). See docs/computer-use.md.
# Model for the Responses tool loop. Chat keeps OPENAI_MODEL_ANSWER.
# OPENAI_MODEL_COMPUTER=gpt-6-astra
# Serves /harness/kb on loopback. Leave unset in production.
# COMPUTER_USE_FIXTURE=1
# Optional isolated vector store for that page. Do not point it at a team library.
# COMPUTER_USE_VECTOR_STORE=

# --- MCP (remote agents). Server only. See docs/MCP.md.
# This token is what other agents send as Authorization: Bearer.
# It is scoped to MCP_TEAM_ID. Do not reuse the OpenAI key or the service role.
# MCP_API_KEY=
# MCP_TEAM_ID=
# Optional extra teams: JSON array of { "teamId", "token" }.
# MCP_API_KEYS=

# --- One-off migration from Azure (only for scripts/migrate-cosmos-to-supabase.mjs).
# The app itself no longer uses Azure. Delete these after the import.
# COSMOSDB_CONNECTION_STRING=
# COSMOSDB_DATABASE_NAME=aisearch
# COSMOSDB_CONTAINER_NAME=aisearch
